{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timetogrowup.github.io/P-123-wenare/schemas/trip-calls.schema.json",
  "title": "WENARE trip calls v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generationId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generationId": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "descriptor": {
      "type": "object",
      "required": [
        "file",
        "bytes",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^trip-calls/[A-Za-z0-9_-]+/"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "const": "gzip-json"
        },
        "decodedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "kind",
        "quality",
        "lines",
        "selectionValidFromUtc",
        "selectionValidUntilUtc"
      ],
      "properties": {
        "kind": {
          "const": "trip-calls"
        },
        "quality": {
          "const": "timetable"
        },
        "lines": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/descriptor"
          }
        }
      }
    },
    {
      "required": [
        "lineId",
        "partitions"
      ],
      "properties": {
        "lineId": {
          "type": "string"
        },
        "partitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/descriptor"
          }
        }
      }
    },
    {
      "required": [
        "lineId",
        "courses",
        "patterns",
        "timeTemplates",
        "stops",
        "serviceDays"
      ],
      "properties": {
        "courses": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "patternRef",
              "timeTemplateRef",
              "serviceDates",
              "terminusStopId",
              "terminusStopSequence",
              "availability"
            ]
          }
        },
        "patterns": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string"
                },
                {
                  "enum": [
                    "0",
                    "1",
                    "2",
                    "3"
                  ]
                },
                {
                  "enum": [
                    "0",
                    "1",
                    "2",
                    "3"
                  ]
                }
              ]
            }
          }
        },
        "timeTemplates": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 604799
                },
                {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 604799
                },
                {
                  "enum": [
                    "0",
                    "1",
                    null
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
